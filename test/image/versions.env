# Pins for the full-image suite (test/image/run.sh, `task e2e:image`) on top
# of the kind, kubectl, cert-manager, Contour and whoami pins it reuses from
# test/kind/versions.env. Every image is pinned by digest; bump deliberately
# and re-verify against the upstream registry.

# nginx serves an issued leaf with OCSP stapling (stable line).
NGINX_IMAGE=docker.io/library/nginx:1.30.5-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
