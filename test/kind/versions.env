# Pinned tools, images and manifests for the kind ACME end-to-end test
# (test/kind/run.sh, `task e2e:kind`). Every download is checked against the
# SHA-256 here and every image is pinned by digest; bump deliberately and
# re-verify each value against the upstream release.

# kind: https://github.com/kubernetes-sigs/kind/releases/tag/v0.33.0
KIND_VERSION=v0.33.0
KIND_SHA256_AMD64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_SHA256_ARM64=20022bee6cfcd5086cb7234d218e3454e6090022f2a8f55d1fa7fcf42c3867a2
# The node image kind v0.33.0 lists for Kubernetes v1.37.0.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# kubectl matching the node's Kubernetes version (dl.k8s.io publishes .sha256).
KUBECTL_VERSION=v1.37.0
KUBECTL_SHA256_AMD64=6129359f4e1f3848a5572ccb0b26cf28b8ca08cef38c95a765b2f64a2c961a2f
KUBECTL_SHA256_ARM64=922df28df248cc00a9e025f947704f1d1482de64ece54cfe57e61f19eaf1eef3

# cert-manager static manifest from the v1.21.2 release assets.
CERT_MANAGER_VERSION=v1.21.2
CERT_MANAGER_SHA256=e03b668ec8675214af6b0a671699d088f2601fa3878e0dbe1b41d3feafd1879f

# Contour's rendered quickstart manifest (Envoy DaemonSet on hostPort 80/443).
CONTOUR_VERSION=v1.33.7
CONTOUR_SHA256=96caefecf8272bde6467528514a3ead14bf165176ad6711bc11ab141c1ae62c8

# The test app behind the ingress.
WHOAMI_IMAGE=docker.io/traefik/whoami:v1.12.0@sha256:c4717a8d1f0134a7444e24f881160e033991f23027c6c5a9a3f8fd22e70d1d44
